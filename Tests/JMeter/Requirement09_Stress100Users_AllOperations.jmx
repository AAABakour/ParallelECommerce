                <stringProp name="Argument.value">{&quot;productId&quot;:1,&quot;quantity&quot;:1,&quot;customerEmail&quot;:&quot;stress-user-${__threadNum}@example.com&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
